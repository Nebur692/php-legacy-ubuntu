From 091295f7ee607939c60abd4d698a1634a9d8456d Mon Sep 17 00:00:00 2001
From: Nebur692 <nebur_692@hotmail.com>
Date: Tue, 10 Nov 2026 00:38:15 +0100
Subject: [PATCH] Fix GHSA-www2-q4fc-65wf: null byte termination in
 dns_get_record() and other network functions [backport to PHP 7.0]

Parse the host/service/protocol names of dns_check_record(), dns_get_mx(),
dns_get_record(), getprotobyname(), getservbyname(), getservbyport(),
inet_pton() and ip2long() as paths ("p"), so that strings with an embedded
NUL byte are rejected instead of being silently truncated by the C
resolver functions.

Origin: php-src ed70b1ea43a9b7ffa2f53b3e5d6ba403f37ae81c (Niels Dossche),
via Remi Collet's 7.4 backport.
Adaptation: 7.0 still uses zend_parse_parameters() with format strings in
these functions, so "s" became "p" by hand (dns_win32.c included). The
older ZPP tests still present in 7.0 (getservbyname_variation*,
ip2long_variation1, ip.phpt) now expect "a valid path" instead of
"string" in the warning, as ip_x86_64.phpt does upstream.
---
diff --git a/ext/standard/basic_functions.c b/ext/standard/basic_functions.c
index 7671cabb..888d05ef 100644
--- a/ext/standard/basic_functions.c
+++ b/ext/standard/basic_functions.c
@@ -3910,7 +3910,7 @@ PHP_NAMED_FUNCTION(php_inet_pton)
 	size_t address_len;
 	char buffer[17];
 
-	if (zend_parse_parameters(ZEND_NUM_ARGS(), "s", &address, &address_len) == FAILURE) {
+	if (zend_parse_parameters(ZEND_NUM_ARGS(), "p", &address, &address_len) == FAILURE) {
 		RETURN_FALSE;
 	}
 
@@ -3950,7 +3950,7 @@ PHP_FUNCTION(ip2long)
 	zend_ulong ip;
 #endif
 
-	if (zend_parse_parameters(ZEND_NUM_ARGS(), "s", &addr, &addr_len) == FAILURE) {
+	if (zend_parse_parameters(ZEND_NUM_ARGS(), "p", &addr, &addr_len) == FAILURE) {
 		return;
 	}
 
@@ -5542,7 +5542,7 @@ PHP_FUNCTION(getservbyname)
 	size_t name_len, proto_len;
 	struct servent *serv;
 
-	if (zend_parse_parameters(ZEND_NUM_ARGS(), "ss", &name, &name_len, &proto, &proto_len) == FAILURE) {
+	if (zend_parse_parameters(ZEND_NUM_ARGS(), "pp", &name, &name_len, &proto, &proto_len) == FAILURE) {
 		return;
 	}
 
@@ -5585,7 +5585,7 @@ PHP_FUNCTION(getservbyport)
 	zend_long port;
 	struct servent *serv;
 
-	if (zend_parse_parameters(ZEND_NUM_ARGS(), "ls", &port, &proto, &proto_len) == FAILURE) {
+	if (zend_parse_parameters(ZEND_NUM_ARGS(), "lp", &port, &proto, &proto_len) == FAILURE) {
 		return;
 	}
 
@@ -5609,7 +5609,7 @@ PHP_FUNCTION(getprotobyname)
 	size_t name_len;
 	struct protoent *ent;
 
-	if (zend_parse_parameters(ZEND_NUM_ARGS(), "s", &name, &name_len) == FAILURE) {
+	if (zend_parse_parameters(ZEND_NUM_ARGS(), "p", &name, &name_len) == FAILURE) {
 		return;
 	}
 
diff --git a/ext/standard/dns.c b/ext/standard/dns.c
index d85fbe12..0d8d913e 100644
--- a/ext/standard/dns.c
+++ b/ext/standard/dns.c
@@ -372,7 +372,7 @@ PHP_FUNCTION(dns_check_record)
 	struct __res_state *handle = &state;
 #endif
 
-	if (zend_parse_parameters(ZEND_NUM_ARGS(), "s|s", &hostname, &hostname_len, &rectype, &rectype_len) == FAILURE) {
+	if (zend_parse_parameters(ZEND_NUM_ARGS(), "p|s", &hostname, &hostname_len, &rectype, &rectype_len) == FAILURE) {
 		return;
 	}
 
@@ -817,7 +817,7 @@ PHP_FUNCTION(dns_get_record)
 	int type, first_query = 1, store_results = 1;
 	zend_bool raw = 0;
 
-	if (zend_parse_parameters(ZEND_NUM_ARGS(), "s|lz/!z/!b",
+	if (zend_parse_parameters(ZEND_NUM_ARGS(), "p|lz/!z/!b",
 			&hostname, &hostname_len, &type_param, &authns, &addtl, &raw) == FAILURE) {
 		return;
 	}
@@ -1048,7 +1048,7 @@ PHP_FUNCTION(dns_get_mx)
 	struct __res_state *handle = &state;
 #endif
 
-	if (zend_parse_parameters(ZEND_NUM_ARGS(), "sz/|z/", &hostname, &hostname_len, &mx_list, &weight_list) == FAILURE) {
+	if (zend_parse_parameters(ZEND_NUM_ARGS(), "pz/|z/", &hostname, &hostname_len, &mx_list, &weight_list) == FAILURE) {
 		return;
 	}
 
