@@ -0,0 +1,69 @@
+--TEST--
+#GHSA-hrwm-9436-5mv3: pgsql escaping errors with an incomplete multibyte character
+--DESCRIPTION--
+Same checks as ghsa-hrwm-9436-5mv3.phpt, but with a string that ends in an
+incomplete UTF-8 sequence, which every libpq version reports as an escaping
+error (the upstream test needs a libpq that validates the whole sequence).
+--SKIPIF--
+<?php include("skipif.inc"); ?>
+--FILE--
+<?php
+
+include 'config.inc';
+
+$db = pg_connect($conn_str);
+pg_set_client_encoding($db, "UTF8");
+pg_query($db, "DROP TABLE IF EXISTS ghsa_hrmw_9436_5mv3_mb");
+pg_query($db, "CREATE TABLE ghsa_hrmw_9436_5mv3_mb (bar text);");
+
+$invalid = "ABC\xe3\x81";
+$flags = PGSQL_DML_NO_CONV | PGSQL_DML_ESCAPE;
+
+var_dump(pg_insert($db, $invalid, array('bar' => 'test'))); // table name str escape in php_pgsql_meta_data
+var_dump(pg_insert($db, "tbl.$invalid", array('bar' => 'test'))); // table name after the schema in php_pgsql_meta_data
+var_dump(pg_insert($db, 'ghsa_hrmw_9436_5mv3_mb', array('bar' => $invalid))); // converted value str escape in php_pgsql_convert
+var_dump(pg_insert($db, $invalid, array())); // ident escape in build_tablename
+var_dump(pg_insert($db, 'ghsa_hrmw_9436_5mv3_mb', array($invalid => 'foo'), $flags)); // ident escape for field php_pgsql_insert
+var_dump(pg_insert($db, 'ghsa_hrmw_9436_5mv3_mb', array('bar' => $invalid), $flags)); // str escape for field value in php_pgsql_insert
+var_dump(pg_update($db, 'ghsa_hrmw_9436_5mv3_mb', array('bar' => 'val'), array($invalid => 'test'), $flags)); // ident escape in build_assignment_string
+var_dump(pg_update($db, 'ghsa_hrmw_9436_5mv3_mb', array('bar' => 'val'), array('bar' => $invalid), $flags)); // invalid str escape in build_assignment_string
+try {
+    var_dump(pg_escape_string($db, $invalid));
+} catch (Exception $e) {
+    echo $e->getMessage(), "\n";
+}
+var_dump(pg_num_rows(pg_query($db, "SELECT * FROM ghsa_hrmw_9436_5mv3_mb")));
+
+?>
+--CLEAN--
+<?php
+include 'config.inc';
+$db = pg_connect($conn_str);
+pg_query($db, "DROP TABLE IF EXISTS ghsa_hrmw_9436_5mv3_mb");
+?>
+--EXPECTF--
+Warning: pg_insert(): Escaping table name 'ABC%s' failed in %s on line %d
+bool(false)
+
+Warning: pg_insert(): Escaping table name 'tbl.ABC%s' failed in %s on line %d
+bool(false)
+
+Notice: pg_insert(): String value escaping failed for PostgreSQL 'text' (bar) in %s on line %d
+bool(false)
+
+Notice: pg_insert(): Failed to escape table name 'ABC%s' in %s on line %d
+bool(false)
+
+Notice: pg_insert(): Failed to escape field 'ABC%s' in %s on line %d
+bool(false)
+
+Notice: pg_insert(): Failed to escape field 'bar' value in %s on line %d
+bool(false)
+
+Notice: pg_update(): Failed to escape field 'ABC%s' in %s on line %d
+bool(false)
+
+Notice: pg_update(): Failed to escape field 'bar' value in %s on line %d
+bool(false)
+Escaping string failed
+int(0)
