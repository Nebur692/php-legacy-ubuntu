+--SKIPIF--
+<?php
+if (!extension_loaded('xml')) die('skip xml extension not available');
+?>
+--FILE--
+<?php
+/* Fill the small string slots so that an out-of-bounds read past a tag
+ * name lands on non-zero bytes. */
+$fill = array();
+for ($i = 0; $i < 4096; $i++) {
+    $fill[] = str_repeat("A", 7);
+}
+for ($i = 0; $i < 4096; $i += 2) {
+    unset($fill[$i]);
+}
+$sample = "<?xml version=\"1.0\"?><test><child/></test>";
+$bad = array();
+for ($off = 5; $off <= 128; $off++) {
+    $parser = xml_parser_create();
+    xml_parser_set_option($parser, XML_OPTION_SKIP_TAGSTART, $off);
+    xml_parse_into_struct($parser, $sample, $vals, $index);
+    foreach (array_keys($index) as $key) {
+        if ($key !== "") {
+            $bad[] = $off;
+        }
+    }
+    xml_parser_free($parser);
+}
+var_dump(count($bad));
+?>
+--EXPECT--
+int(0)
