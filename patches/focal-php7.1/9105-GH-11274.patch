From fc778d522878482436c9e4a1ea5cf943708439e3 Mon Sep 17 00:00:00 2001
From: Nebur692 <nebur_692@hotmail.com>
Date: Fri, 20 Nov 2026 10:26:17 +0100
Subject: [PATCH] Fix GH-11274: POST/PATCH request switches to GET after a HTTP
 308 redirect [backport to PHP 7.1]

RFC 7231 states that status code 307 should keep the POST method upon
redirect. RFC 7538 does the same for code 308. Although it's not
mandated by the RFCs that PATCH is also kept (we can choose), it seems
like keeping PATCH will be the most consistent and understandable behaviour.

This patch also changes an existing test because it was testing for the
wrong behaviour.

Prerequisite of the GHSA-fpwc-w8rq-cr92 fix (HTTP_WRAPPER_KEEP_METHOD).

Upstream: 1ede3137c9abe19da1fafef66d8e4038c63516b4 (Niels Dossche,
closes GH-11275), as shipped by Remi Collet for 7.4
(8.2.34-to-7.4-09-Fix-GH-11274-...patch).

Adapted: the test starts the CLI server with the 7.1 signature of
php_cli_server_start() (no array of extra arguments).

Re-applied on top of Sury's 7.1 build of 19 November 2026: his http
wrapper now has GHSA-fpwc-w8rq-cr92 (HTTP_WRAPPER_STRIP_AUTH = 8, with bit 4
left free) but not this fix; KEEP_METHOD is added to the new_flags it
computes for the redirect, as upstream does.
---
 ext/standard/http_fopen_wrapper.c     | 16 ++++++++++++----
 ext/standard/tests/http/bug67430.phpt |  2 +-
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/ext/standard/http_fopen_wrapper.c b/ext/standard/http_fopen_wrapper.c
index b27feaef..a4a2f186 100644
--- a/ext/standard/http_fopen_wrapper.c
+++ b/ext/standard/http_fopen_wrapper.c
@@ -85,6 +85,7 @@
 
 #define HTTP_WRAPPER_HEADER_INIT    1
 #define HTTP_WRAPPER_REDIRECTED     2
+#define HTTP_WRAPPER_KEEP_METHOD    4
 #define HTTP_WRAPPER_STRIP_AUTH     8
 
 static char *next_header_line(char *line)
@@ -387,6 +388,7 @@ php_stream *php_stream_url_wrap_http_ex(php_stream_wrapper *wrapper,
 	char *user_headers = NULL;
 	int header_init = ((flags & HTTP_WRAPPER_HEADER_INIT) != 0);
 	int redirected = ((flags & HTTP_WRAPPER_REDIRECTED) != 0);
+	int redirect_keep_method = ((flags & HTTP_WRAPPER_KEEP_METHOD) != 0);
 	int response_code;
 	zend_array *symbol_table;
 	smart_str req_buf = {0};
@@ -627,7 +629,7 @@ finish:
 		if (Z_TYPE_P(tmpzval) == IS_STRING && Z_STRLEN_P(tmpzval) > 0) {
 			/* As per the RFC, automatically redirected requests MUST NOT use other methods than
 			 * GET and HEAD unless it can be confirmed by the user */
-			if (!redirected
+			if (!redirected || redirect_keep_method
 				|| (Z_STRLEN_P(tmpzval) == 3 && memcmp("GET", Z_STRVAL_P(tmpzval), 3) == 0)
 				|| (Z_STRLEN_P(tmpzval) == 4 && memcmp("HEAD",Z_STRVAL_P(tmpzval), 4) == 0)
 			) {
@@ -715,7 +717,7 @@ finish:
 			php_strtolower(ZSTR_VAL(tmp), ZSTR_LEN(tmp));
 			t = ZSTR_VAL(tmp);
 
-			if (!header_init) {
+			if (!header_init && !redirect_keep_method) {
 				/* strip POST headers on redirect */
 				strip_header(user_headers, t, "content-length");
 				strip_header(user_headers, t, "content-type");
@@ -878,7 +880,7 @@ finish:
 		 * see bug #44603 for details. Since Content-Type maybe part of user's headers we need to do this check first.
 		 */
 		if (
-				header_init &&
+				(header_init || redirect_keep_method) &&
 				context &&
 				!(have_header & HTTP_HEADER_CONTENT_LENGTH) &&
 				(tmpzval = php_stream_context_get_option(context, "http", "content")) != NULL &&
@@ -896,7 +898,7 @@ finish:
 	}
 
 	/* Request content, such as for POST requests */
-	if (header_init && context &&
+	if ((header_init || redirect_keep_method) && context &&
 		(tmpzval = php_stream_context_get_option(context, "http", "content")) != NULL &&
 		Z_TYPE_P(tmpzval) == IS_STRING && Z_STRLEN_P(tmpzval) > 0) {
 		if (!(have_header & HTTP_HEADER_CONTENT_LENGTH)) {
@@ -1179,6 +1181,12 @@ finish:
 				CHECK_FOR_CNTRL_CHARS(resource->path)
 			}
 			int new_flags = HTTP_WRAPPER_REDIRECTED | (flags & HTTP_WRAPPER_STRIP_AUTH);
+			if (response_code == 307 || response_code == 308) {
+				/* RFC 7538 specifies that status code 308 does not allow changing the request method from POST to GET.
+				 * RFC 7231 does the same for status code 307.
+				 * To keep consistency between POST and PATCH requests, we'll also not change the request method from PATCH to GET, even though it's allowed it's not mandated by the RFC. */
+				new_flags |= HTTP_WRAPPER_KEEP_METHOD;
+			}
 			if (!same_origin) {
 				new_flags |= HTTP_WRAPPER_STRIP_AUTH;
 			}
diff --git a/ext/standard/tests/http/bug67430.phpt b/ext/standard/tests/http/bug67430.phpt
index a563951c..61c7080f 100644
--- a/ext/standard/tests/http/bug67430.phpt
+++ b/ext/standard/tests/http/bug67430.phpt
@@ -41,7 +41,7 @@ POST / HTTP/1.0
 Host: 127.0.0.1:12342
 Connection: close
 
-GET /foo HTTP/1.0
+POST /foo HTTP/1.0
 Host: 127.0.0.1:12342
 Connection: close
 
-- 
