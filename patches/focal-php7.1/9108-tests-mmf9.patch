From 5ebe9c0c2727fd2c39eaf927b08eec5e9c83de28 Mon Sep 17 00:00:00 2001
From: Nebur692 <nebur_692@hotmail.com>
Date: Fri, 20 Nov 2026 15:11:44 +0100
Subject: [PATCH] tests: GHSA-mmf9-xm3v-hg2x test compares two sizes instead of
 a fixed time limit

The first version folded one header over 200000 lines and failed above
10 seconds; with the quadratic copy that took about 3 s on the build host,
so it passed on the unfixed code too. Now one request folds it over 25000
lines and another over 200000: about 8 times the time when appending, about
64 times when the whole header is copied for every line. It fails when the
ratio is above 24 (unless the big one takes under a second). Measured on
the 7.0 build host, 3 runs each: unfixed 0.03 s / 2.92 s, ratio 94 (FAIL);
fixed, PASS.
---
 .../tests/http/ghsa-mmf9-xm3v-hg2x.phpt       | 44 +++++++++++--------
 1 file changed, 25 insertions(+), 19 deletions(-)

diff --git a/ext/standard/tests/http/ghsa-mmf9-xm3v-hg2x.phpt b/ext/standard/tests/http/ghsa-mmf9-xm3v-hg2x.phpt
index 65516479..6b5aaf32 100644
--- a/ext/standard/tests/http/ghsa-mmf9-xm3v-hg2x.phpt
+++ b/ext/standard/tests/http/ghsa-mmf9-xm3v-hg2x.phpt
@@ -13,27 +13,30 @@ $serverCode = <<<'CODE'
         "tcp://127.0.0.1:0", $errno, $errstr, STREAM_SERVER_BIND | STREAM_SERVER_LISTEN, $ctxt);
     phpt_notify_server_start($server);
 
-    $conn = stream_socket_accept($server);
- /* Read the whole request before answering: the 5.6 client sends the final "\r\n" apart, and closing
-  * before it arrives resets the connection ("send of 2 bytes failed ... Connection reset by peer"). */
- $req = ''; while (strpos($req, "\r\n\r\n") === false && !feof($conn) && ($b = fread($conn, 1024)) !== false && $b !== '') { $req .= $b; }
-
-    phpt_notify(WORKER_DEFAULT_NAME, "server-accepted");
-
-    /* One header folded over 200000 continuation lines: with the old copy of the whole
-     * header for every line this takes minutes, appending takes a fraction of a second. */
-    fwrite($conn, "HTTP/1.0 200 Ok\r\nX-Folded: a" . str_repeat("\r\n b", 200000) . "\r\nContent-Type: text/plain\r\n\r\nbody\r\n");
+    /* Two requests: one header folded over 25000 lines, then over 200000 (8 times more). */
+    foreach ([25000, 200000] as $lines) {
+        $conn = stream_socket_accept($server);
+     /* Read the whole request before answering: the 5.6 client sends the final "\r\n" apart, and closing
+      * before it arrives resets the connection ("send of 2 bytes failed ... Connection reset by peer"). */
+     $req = ''; while (strpos($req, "\r\n\r\n") === false && !feof($conn) && ($b = fread($conn, 1024)) !== false && $b !== '') { $req .= $b; }
+        fwrite($conn, "HTTP/1.0 200 Ok\r\nX-Folded: a" . str_repeat("\r\n b", $lines) . "\r\nContent-Type: text/plain\r\n\r\nbody\r\n");
+        fclose($conn);
+    }
 CODE;
 
 $clientCode = <<<'CODE'
-    $start = microtime(true);
-    var_dump(trim(file_get_contents("http://{{ ADDR }}")));
-    $elapsed = microtime(true) - $start;
-    var_dump(count($http_response_header));
-    var_dump(strlen($http_response_header[1]));
-    var_dump(substr($http_response_header[1], 0, 16));
-    var_dump($http_response_header[2]);
-    echo $elapsed < 10 ? "linear\n" : "too slow: $elapsed s\n";
+    $time = [];
+    foreach ([25000, 200000] as $lines) {
+        $start = microtime(true);
+        $body = trim(file_get_contents("http://{{ ADDR }}"));
+        $time[$lines] = microtime(true) - $start;
+        var_dump($body, count($http_response_header), strlen($http_response_header[1]), $http_response_header[2]);
+    }
+    /* 8 times the lines: about 8 times the time when appending, about 64 times when the whole
+     * header is copied for every line. A ratio is used instead of a fixed time limit, so a slow or
+     * busy machine does not change the verdict; under one second for the big one is linear anyway. */
+    $ratio = $time[200000] / max($time[25000], 0.001);
+    echo ($time[200000] < 1.0 || $ratio < 24) ? "linear\n" : sprintf("quadratic: %.2f s and %.2f s, ratio %.1f\n", $time[25000], $time[200000], $ratio);
 CODE;
 
 include sprintf("%s/../../../openssl/tests/ServerClientTestCase.inc", __DIR__);
@@ -42,7 +45,10 @@ ServerClientTestCase::getInstance()->run($clientCode, $serverCode);
 --EXPECT--
 string(4) "body"
 int(3)
+int(50011)
+string(24) "Content-Type: text/plain"
+string(4) "body"
+int(3)
 int(400011)
-string(16) "X-Folded: a b b "
 string(24) "Content-Type: text/plain"
 linear
-- 
2.55.0

