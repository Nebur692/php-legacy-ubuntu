From: =?UTF-8?q?Ond=C5=99ej=20Sur=C3=BD?= <ondrej@sury.org>
Date: Tue, 17 Nov 2026 12:19:41 +0100
Subject: [PATCH] fix GHSA-q23r tests for 5.6 (use SKIPIF, run-tests.php looks
 up EXTENSIONS modules in the compiled-in extension_dir)

---
 ext/soap/tests/GHSA-q23r-hr55-xmpg-wsdl.phpt | 4 ++--
 ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt      | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/ext/soap/tests/GHSA-q23r-hr55-xmpg-wsdl.phpt b/ext/soap/tests/GHSA-q23r-hr55-xmpg-wsdl.phpt
index d5605042..6cc840b2 100644
--- a/ext/soap/tests/GHSA-q23r-hr55-xmpg-wsdl.phpt
+++ b/ext/soap/tests/GHSA-q23r-hr55-xmpg-wsdl.phpt
@@ -1,7 +1,7 @@
 --TEST--
 GHSA-q23r-hr55-xmpg: Unbounded array walk on empty wsdl:arraySize
---EXTENSIONS--
-soap
+--SKIPIF--
+<?php require_once('skipif.inc'); ?>
 --INI--
 soap.wsdl_cache_enabled=0
 --FILE--
diff --git a/ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt b/ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt
index 9ff7a621..5f637609 100644
--- a/ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt
+++ b/ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt
@@ -1,7 +1,7 @@
 --TEST--
 GHSA-q23r-hr55-xmpg: Out-of-bounds read on empty SOAP-ENC:arraySize
---EXTENSIONS--
-soap
+--SKIPIF--
+<?php require_once('skipif.inc'); ?>
 --FILE--
 <?php
 
