From 61eca7bd4f0660e9a033d2675f56926b175beb13 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ond=C5=99ej=20Sur=C3=BD?= <ondrej@sury.org>
Date: Tue, 17 Nov 2026 08:48:21 +0100
Subject: [PATCH] add GHSA-gr4f test for 7.1 and older (no zend_test extension,
 check the time zone of the logged messages)

(cherry picked from commit 48f784b29f89e976ebaf52c2fba4a691d5b677a9)
(cherry picked from commit cf57aabcb179dd3f643e7bfe5b14952fd0e9f4dd)
---
 ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt | 35 +++++++++++++++++++++++++
 1 file changed, 35 insertions(+)
 create mode 100644 ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt

diff --git a/ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt b/ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt
new file mode 100644
index 00000000..a554a68d
--- /dev/null
+++ b/ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt
@@ -0,0 +1,35 @@
+--TEST--
+GHSA-gr4f-wgx5-jpfv: DATEG(tzcache) use-after-free
+--CREDITS--
+Sebastian Bergmann
+--GET--
+a=1&b=2
+--INI--
+error_log="{PWD}/GHSA-gr4f-wgx5-jpfv.log"
+log_errors=1
+max_input_vars=1
+date.timezone=Europe/Prague
+extension=GHSA-gr4f-wgx5-jpfv-does-not-exist
+--FILE--
+<?php
+/* There is no zend_test extension here: a missing extension gives the warning
+ * during module startup. The time zone cache must only be used while a request
+ * is active, so messages logged outside of it carry UTC timestamps. */
+error_log("in request");
+foreach (file(__DIR__ . "/GHSA-gr4f-wgx5-jpfv.log") as $line) {
+    if (preg_match('/^\[\S+ \S+ (\S+)\] (?:PHP Warning:  )?(PHP Startup|Unknown|in request)/', $line, $m)) {
+        echo $m[2], ": ", $m[1], "\n";
+    }
+}
+echo "Hello world\n";
+?>
+--CLEAN--
+<?php
+@unlink(__DIR__ . "/GHSA-gr4f-wgx5-jpfv.log");
+?>
+--EXPECTF--
+%AWarning: Unknown: Input variables exceeded 1. To increase the limit change max_input_vars in php.ini. in Unknown on line 0
+PHP Startup: UTC
+Unknown: UTC
+in request: Europe/Prague
+Hello world%A
-- 
2.55.0

